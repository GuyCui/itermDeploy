[Unit]
Description=Fetch SublinkPro with a longer deadline and publish validated nodes
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
Type=oneshot
User=root
Environment=TZ=Asia/Shanghai
EnvironmentFile=-/etc/mihomo-health-guard.env
ExecStart=/usr/bin/python3 /usr/local/lib/mihomo-health-guard/provider_cache_sync.py
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/mihomo/provider-cache /var/lib/mihomo-speed-guard
